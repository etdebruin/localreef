{
  "name": "localreef",
  "version": "0.1.0",
  "description": "A shell for local apps. Address them by name, not by port.",
  "homepage": "https://localreef.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etdebruin/localreef.git"
  },
  "bugs": {
    "url": "https://github.com/etdebruin/localreef/issues"
  },
  "license": "MIT",
  "author": "Etienne de Bruin",
  "keywords": [
    "electron",
    "localhost",
    "local-first",
    "developer-tools",
    "app-launcher",
    "desktop"
  ],
  "private": true,
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test 'test/**/*.test.js'",
    "lint": "eslint .",
    "test:electron": "electron test/electron/iframe-auth.mjs",
    "test:electron:ui": "electron test/electron/window-controls.mjs",
    "test:vite": "node test/vite/hmr.mjs",
    "shot": "node scripts/shot.mjs",
    "test:electron:ws": "electron test/electron/iframe-websocket.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "electron": "^43.3.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0"
  }
}
